PORT=5000
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="liquidity-square-super-secret-jwt-key-2026-production-ready"

# -----------------------------------------------------------------------------
# SUPABASE DATABASE SETTINGS (Prisma PostgreSQL)
# -----------------------------------------------------------------------------
# In your Supabase dashboard: Project Settings -> Database -> Connection string
# 
# 1. DATABASE_URL (Transaction Pooler - port 6543 with pgbouncer=true)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Direct Connection - port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase project credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
